MAINNET_RPC=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
MAINNET_RPC_FALLBACK=
FORK_BLOCK=20500000
CHAIN=mainnet
ANVIL_PORT=8545

# --- risk policy overrides (agent/src/risk/buffer.ts's DEFAULT_POLICY) ---
# optional: both unset means "use RiskPolicy's own default". Set either to
# demonstrate the dynamic buffer without editing source -- e.g. doubling
# REACTION_WINDOW_SEC must visibly widen targetHF (plan.md §7 criterion 4).
REACTION_WINDOW_SEC=
RISK_Z=

# --- keeper backend server (pnpm server) ---
PORT=8080
TICK_INTERVAL_MS=15000
LOG_PATH=decision-real.log.json
ALLOWED_ORIGIN=*
# optional: enables real on-chain mode instead of the simulated market --
# needs a reachable read RPC (READ_RPC_URL, or MAINNET_RPC with
# READ_MODE=mainnet); falls back to the simulated market if unreachable
WATCH_ADDRESS=
# optional: guards GET /api/status only -- unset means that endpoint 401s
# every request (fails closed, never open). /api/decisions and /health
# stay unauthenticated either way.
AGENT_API_TOKEN=

# --- dashboard (Next.js) ---
# point the deployed dashboard at a deployed backend instead of local files
BACKEND_URL=
# optional: enables the voice agent (dashboard/app/components/VoiceAgent.tsx).
# Public by Next.js convention (NEXT_PUBLIC_ prefix) -- fine, agent IDs
# aren't secret. Used directly if ELEVENLABS_API_KEY below isn't set.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# optional, server-side only -- never sent to the browser. Set this (with a
# private agent) to mint signed conversation URLs via /api/signed-url
# instead of connecting with the public agent ID directly.
ELEVENLABS_API_KEY=
