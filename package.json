{
  "name": "liquidation-shield",
  "version": "1.0.0",
  "description": "Closed-loop control system that protects leveraged Aave v3 positions from liquidation.",
  "main": "index.js",
  "scripts": {
    "fork": "bash scripts/fork.sh",
    "seed": "tsx scripts/seedPosition.ts",
    "crash": "tsx scripts/crashPrice.ts",
    "assess": "tsx agent/src/risk/assess.ts",
    "plan": "tsx agent/src/planner-cli.ts",
    "test": "vitest run",
    "test:keeper": "node --test --experimental-strip-types agent/src/keeper-backend/tests/*.test.ts",
    "demo:save": "node --experimental-strip-types scripts/scenarios/01-save.ts",
    "demo:refuse": "node --experimental-strip-types scripts/scenarios/02-refuse.ts",
    "demo:real": "tsx scripts/scenarios/03-real.ts"
  },
  "keywords": ["aave", "defi", "liquidation", "flash-loan", "ethereum"],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "dependencies": {
    "@bgd-labs/aave-address-book": "^4.44.22",
    "dotenv": "^17.4.2",
    "viem": "^2.56.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
